// AirPermitHub database, P0: sign-in, provenance, versioned reference content,
// and review. Design: "AirPermitHub P0 + P1 Audit and Architecture"
// (docs/design/p0-p1-schema.prisma has the full P0 + P1 proposal).
//
// Rules the schema carries (R numbers match the design doc):
// R1  A version is published only with a citation to an official source.
// R2  Numbers appear only as verbatim quotes, or as restated text that stays
//     labeled "summarized from source" and keeps a review task open.
// R3  Published versions are never edited; a change is a new version.
// R4  The reviewer of a version is never its author.
// R9  Every write to regulatory data adds an AuditLog row; the log is append-only.
//
// What Prisma can't express lives in prisma/migrations/*_p0_rules (SQL):
// one PUBLISHED version per record, the R1 publish check, R3 immutability,
// the R4 check, one version per Citation, Source.isOfficial from the
// OfficialDomain allowlist, and the append-only AuditLog.
//
// Version rows hold the record in the shape the site renders (scalar columns
// plus JSON for nested lists), so a database export matches data/ exactly.
// Citation rows are derived from those fields by src/lib/content/citations.ts
// on every write, and carry the provenance the rules check.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Enums ───────────────────────────

enum PlatformRole {
  USER
  EDITOR
  REVIEWER
  ADMIN
}

enum AccountType {
  INDIVIDUAL
  CONSULTANT
  COMPANY
}

enum PlanTier {
  FREE
  PROFESSIONAL
  TEAM
  ENTERPRISE
}

enum Jurisdiction {
  FEDERAL
  STATE
  LOCAL
  TRIBAL
}

enum VersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum ContentStatus {
  OFFICIAL_SOURCE
  APH_SUMMARY
  NEEDS_REVIEW
  RECENTLY_UPDATED
  ARCHIVED
}

enum Verification {
  VERIFIED
  PARTIAL
  UNVERIFIED
}

enum SourceKind {
  RULE_TEXT
  FEDERAL_REGISTER
  GUIDANCE
  FORM
  DATA
  AGENCY_PAGE
  OTHER
}

/// What a citation supports on its version.
enum CitationRole {
  PRIMARY
  QUOTE
  THRESHOLDS
  FORM
  GUIDANCE
  REGULATION
  SOURCE
  PORTAL
  FEES
  LOCAL_AGENCY
}

enum ContentEntity {
  STATE_PROFILE
  AGENCY
  PERMIT_PROGRAM
  REGULATION
  GLOSSARY_TERM
  SOURCE
  OFFICIAL_DOMAIN
}

enum ReviewKind {
  NEW_RECORD
  CHANGE
  SOURCE_CHANGED
  ERROR_REPORT
  FEDERAL_REGISTER_MATCH
  RESTATED_THRESHOLD
  OFFICIAL_DOMAIN
}

enum ReviewStatus {
  OPEN
  IN_PROGRESS
  APPROVED
  SENT_BACK
  REJECTED
  CLOSED
}

enum PermitType {
  EXEMPTION
  REGISTRATION
  PBR
  GENERAL
  STANDARD
  MINOR_NSR
  PSD
  NNSR
  TITLE_V
  STATE_OPERATING
  OTHER
}

enum ErrorReportStatus {
  NEW
  TRIAGED
  FIXED
  REJECTED
}

// ─────────────────────── Sign-in (Auth.js) ───────────────────────

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  platformRole  PlatformRole @default(USER)
  accountType   AccountType  @default(INDIVIDUAL)
  plan          PlanTier     @default(FREE)
  /// The import and other automated writers. Never signs in.
  isSystem      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  reviewsAssigned ReviewTask[]     @relation("ReviewAssignee")
  reviewsDecided  ReviewTask[]     @relation("ReviewDecider")
  errorReports    ErrorReport[]
  domainsAdded    OfficialDomain[]

  stateProfilesAuthored StateProfileVersion[]  @relation("StateProfileAuthor")
  stateProfilesReviewed StateProfileVersion[]  @relation("StateProfileReviewer")
  agenciesAuthored      AgencyVersion[]        @relation("AgencyAuthor")
  agenciesReviewed      AgencyVersion[]        @relation("AgencyReviewer")
  programsAuthored      PermitProgramVersion[] @relation("ProgramAuthor")
  programsReviewed      PermitProgramVersion[] @relation("ProgramReviewer")
  regulationsAuthored   RegulationVersion[]    @relation("RegulationAuthor")
  regulationsReviewed   RegulationVersion[]    @relation("RegulationReviewer")
  glossaryAuthored      GlossaryTermVersion[]  @relation("GlossaryAuthor")
  glossaryReviewed      GlossaryTermVersion[]  @relation("GlossaryReviewer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────── Provenance ───────────────────────

/// A document at a URL. `isOfficial` is computed from OfficialDomain by a
/// database trigger, never set by hand (R1).
model Source {
  id         String     @id @default(cuid())
  title      String
  url        String     @unique
  kind       SourceKind
  publisher  String
  agencyId   String?
  isOfficial Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  agency    RegulatoryAgency? @relation(fields: [agencyId], references: [id])
  snapshots SourceSnapshot[]
  citations Citation[]
}

/// Allowlist behind R1. A host matches when it equals `domain` or ends with
/// ".<domain>"; "gov" covers every .gov host. Hosts outside .gov are added one
/// by one, each with a note on whose site it is.
model OfficialDomain {
  id           String       @id @default(cuid())
  domain       String       @unique
  jurisdiction Jurisdiction
  note         String?
  addedById    String
  addedAt      DateTime     @default(now())
  addedBy      User         @relation(fields: [addedById], references: [id])
}

/// One fetch of a source. A changed hash opens a SOURCE_CHANGED review task.
model SourceSnapshot {
  id                   String   @id @default(cuid())
  sourceId             String
  retrievedAt          DateTime @default(now())
  httpStatus           Int
  contentHash          String?
  changedSincePrevious Boolean  @default(false)
  source               Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, retrievedAt])
}

/// Ties exactly one version (one of the FKs below, SQL CHECK) to one source.
/// `verbatimQuote` is the only place a threshold may appear as a number (R2).
model Citation {
  id             String       @id @default(cuid())
  sourceId       String
  role           CitationRole
  label          String?
  position       Int          @default(0)
  pinpoint       String?
  verbatimQuote  String?
  quoteCheckedAt DateTime?
  createdAt      DateTime     @default(now())

  stateProfileVersionId String?
  agencyVersionId       String?
  programVersionId      String?
  regulationVersionId   String?
  glossaryVersionId     String?

  source              Source                @relation(fields: [sourceId], references: [id])
  stateProfileVersion StateProfileVersion?  @relation(fields: [stateProfileVersionId], references: [id], onDelete: Cascade)
  agencyVersion       AgencyVersion?        @relation(fields: [agencyVersionId], references: [id], onDelete: Cascade)
  programVersion      PermitProgramVersion? @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  regulationVersion   RegulationVersion?    @relation(fields: [regulationVersionId], references: [id], onDelete: Cascade)
  glossaryVersion     GlossaryTermVersion?  @relation(fields: [glossaryVersionId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([stateProfileVersionId])
  @@index([agencyVersionId])
  @@index([programVersionId])
  @@index([regulationVersionId])
  @@index([glossaryVersionId])
}

// ─────────────────── Reference content: identity + versions ───────────────────
//
// Every *Version model repeats the same envelope, in the same order:
// versionNo, status, contentStatus, verification, effectiveFrom, effectiveTo,
// publishedAt, supersededAt, authorId, reviewedById, reviewedAt,
// revisionNotes, createdAt.

model State {
  id        String @id @default(cuid())
  code      String @unique @db.Char(2)
  slug      String @unique
  name      String
  epaRegion Int

  versions StateProfileVersion[]
  agencies RegulatoryAgency[]
  programs PermitProgram[]
}

model StateProfileVersion {
  id               String    @id @default(cuid())
  stateId          String
  overview         String
  notes            String?
  oilAndGasSummary String?
  lastReviewed     DateTime  @db.Date
  /// [{ name, jurisdiction, url, notes? }]
  localAgencies    Json?
  /// [{ citation, title, url? }]
  regulations      Json
  /// Link lists, each [{ name, url }]; ePermitting and fees are single links.
  forms            Json
  guidance         Json
  sources          Json
  ePermitting      Json?
  fees             Json?

  versionNo     Int
  status        VersionStatus @default(DRAFT)
  contentStatus ContentStatus @default(NEEDS_REVIEW)
  verification  Verification  @default(UNVERIFIED)
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date
  publishedAt   DateTime?
  supersededAt  DateTime?
  authorId      String
  reviewedById  String?
  reviewedAt    DateTime?
  revisionNotes String?
  createdAt     DateTime      @default(now())

  state      State      @relation(fields: [stateId], references: [id])
  author     User       @relation("StateProfileAuthor", fields: [authorId], references: [id])
  reviewedBy User?      @relation("StateProfileReviewer", fields: [reviewedById], references: [id])
  citations  Citation[]

  @@unique([stateId, versionNo])
}

model RegulatoryAgency {
  id           String       @id @default(cuid())
  slug         String       @unique
  jurisdiction Jurisdiction
  stateId      String?

  state    State?          @relation(fields: [stateId], references: [id])
  versions AgencyVersion[]
  sources  Source[]
  programs PermitProgram[]
}

model AgencyVersion {
  id         String  @id @default(cuid())
  agencyId   String
  name       String
  division   String?
  url        String
  permitsUrl String?

  versionNo     Int
  status        VersionStatus @default(DRAFT)
  contentStatus ContentStatus @default(NEEDS_REVIEW)
  verification  Verification  @default(UNVERIFIED)
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date
  publishedAt   DateTime?
  supersededAt  DateTime?
  authorId      String
  reviewedById  String?
  reviewedAt    DateTime?
  revisionNotes String?
  createdAt     DateTime      @default(now())

  agency     RegulatoryAgency @relation(fields: [agencyId], references: [id])
  author     User             @relation("AgencyAuthor", fields: [authorId], references: [id])
  reviewedBy User?            @relation("AgencyReviewer", fields: [reviewedById], references: [id])
  citations  Citation[]

  @@unique([agencyId, versionNo])
}

/// A permit path such as PBR or Title V. `position` orders it on its state
/// hub; `isOilAndGas` puts it in the oil and gas group.
model PermitProgram {
  id          String     @id @default(cuid())
  slug        String     @unique
  stateId     String?
  agencyId    String
  type        PermitType
  isOilAndGas Boolean    @default(false)
  position    Int

  state    State?                 @relation(fields: [stateId], references: [id])
  agency   RegulatoryAgency       @relation(fields: [agencyId], references: [id])
  versions PermitProgramVersion[]

  @@index([stateId, isOilAndGas, position])
}

model PermitProgramVersion {
  id                String  @id @default(cuid())
  programId         String
  name              String
  description       String
  citationText      String?
  url               String?
  /// Verbatim threshold text; the QUOTE citation carries the same text (R2).
  verbatimQuote     String?
  /// { name, url } when the quote comes from a document other than `url`.
  quoteSource       Json?
  /// Restated, not verbatim. Shown as "summarized from source"; keeps a review task open.
  restatedThreshold String?
  thresholdsSource  Json?

  versionNo     Int
  status        VersionStatus @default(DRAFT)
  contentStatus ContentStatus @default(NEEDS_REVIEW)
  verification  Verification  @default(UNVERIFIED)
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date
  publishedAt   DateTime?
  supersededAt  DateTime?
  authorId      String
  reviewedById  String?
  reviewedAt    DateTime?
  revisionNotes String?
  createdAt     DateTime      @default(now())

  program    PermitProgram @relation(fields: [programId], references: [id])
  author     User          @relation("ProgramAuthor", fields: [authorId], references: [id])
  reviewedBy User?         @relation("ProgramReviewer", fields: [reviewedById], references: [id])
  citations  Citation[]

  @@unique([programId, versionNo])
}

model Regulation {
  id           String       @id @default(cuid())
  slug         String       @unique
  shortName    String
  citation     String
  jurisdiction Jurisdiction
  cfrTitle     Int?
  cfrPart      String?
  stateId      String?
  position     Int

  versions    RegulationVersion[]
  relatedFrom RegulationRelation[] @relation("RelFrom")
  relatedTo   RegulationRelation[] @relation("RelTo")

  @@index([cfrTitle, cfrPart])
}

model RegulationVersion {
  id                 String   @id @default(cuid())
  regulationId       String
  name               String
  agency             String
  tagline            String
  summary            String
  /// Each section is { summary: string | null, pointers?: [{ label, citation }] }.
  applicability      Json
  requirements       Json
  monitoring         Json
  testing            Json
  recordkeeping      Json
  reporting          Json
  definitions        Json
  /// [{ code, title }] as published.
  keySubparts        Json?
  /// [{ agency, title, url, citation?, lastReviewed, effectiveDate?, version? }]
  sources            Json
  relatedCalculators String[]

  versionNo     Int
  status        VersionStatus @default(DRAFT)
  contentStatus ContentStatus @default(NEEDS_REVIEW)
  verification  Verification  @default(UNVERIFIED)
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date
  publishedAt   DateTime?
  supersededAt  DateTime?
  authorId      String
  reviewedById  String?
  reviewedAt    DateTime?
  revisionNotes String?
  createdAt     DateTime      @default(now())

  regulation Regulation @relation(fields: [regulationId], references: [id])
  author     User       @relation("RegulationAuthor", fields: [authorId], references: [id])
  reviewedBy User?      @relation("RegulationReviewer", fields: [reviewedById], references: [id])
  citations  Citation[]

  @@unique([regulationId, versionNo])
}

model RegulationRelation {
  fromId   String
  toId     String
  kind     String     @default("related")
  position Int        @default(0)
  from     Regulation @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to       Regulation @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model GlossaryTerm {
  id       String                @id @default(cuid())
  slug     String                @unique
  category String
  position Int
  versions GlossaryTermVersion[]
}

model GlossaryTermVersion {
  id         String   @id @default(cuid())
  termId     String
  term       String
  abbr       String?
  definition String
  /// [{ label, url, match? }]
  cites      Json
  related    String[]
  /// [{ label, href }]
  links      Json?

  versionNo     Int
  status        VersionStatus @default(DRAFT)
  contentStatus ContentStatus @default(NEEDS_REVIEW)
  verification  Verification  @default(UNVERIFIED)
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date
  publishedAt   DateTime?
  supersededAt  DateTime?
  authorId      String
  reviewedById  String?
  reviewedAt    DateTime?
  revisionNotes String?
  createdAt     DateTime      @default(now())

  glossaryTerm GlossaryTerm @relation(fields: [termId], references: [id])
  author       User         @relation("GlossaryAuthor", fields: [authorId], references: [id])
  reviewedBy   User?        @relation("GlossaryReviewer", fields: [reviewedById], references: [id])
  citations    Citation[]

  @@unique([termId, versionNo])
}

// ─────────────────────── Review & audit ───────────────────────

/// The review queue. Detected changes only open a task; they never edit a page.
model ReviewTask {
  id           String        @id @default(cuid())
  kind         ReviewKind
  status       ReviewStatus  @default(OPEN)
  entityType   ContentEntity
  entityId     String
  versionId    String?
  title        String
  detail       String?
  assigneeId   String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  assignee    User?        @relation("ReviewAssignee", fields: [assigneeId], references: [id])
  decidedBy   User?        @relation("ReviewDecider", fields: [decidedById], references: [id])
  errorReport ErrorReport?

  @@index([status, kind])
  @@index([entityType, entityId])
}

/// Append-only: a trigger rejects UPDATE and DELETE.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  workspaceId String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([workspaceId, createdAt])
}

model ErrorReport {
  id           String            @id @default(cuid())
  reporterId   String?
  replyEmail   String?
  pageUrl      String
  message      String
  status       ErrorReportStatus @default(NEW)
  reviewTaskId String?           @unique
  createdAt    DateTime          @default(now())

  reporter   User?       @relation(fields: [reporterId], references: [id])
  reviewTask ReviewTask? @relation(fields: [reviewTaskId], references: [id])
}
